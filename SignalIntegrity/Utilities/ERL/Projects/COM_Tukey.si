<Project>
	<CalculationProperties>
		<EndFrequency>160000000000.0</EndFrequency>
		<FrequencyPoints>1600</FrequencyPoints>
		<UserSampleRate>1062500000000.0</UserSampleRate>
	</CalculationProperties>
	<Drawing>
		<DrawingProperties>
			<Geometry>567x170+28+30</Geometry>
			<Grid>14.0</Grid>
			<Originx>-28</Originx>
			<Originy>-13</Originy>
		</DrawingProperties>
		<Schematic>
			<Devices>
				<Device>
					<ClassName>DeviceLaplace</ClassName>
					<PartPicture>
						<Index>0</Index>
						<MirroredHorizontally>False</MirroredHorizontally>
						<MirroredVertically>False</MirroredVertically>
						<Orientation>0</Orientation>
						<Origin>(46, 18)</Origin>
					</PartPicture>
					<PartProperties>
						<PartProperty>
							<Keyword>ports</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>2</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>eq</Keyword>
							<KeywordVisible>False</KeywordVisible>
							<Value>=laplace_eq</Value>
							<Visible>True</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>ref</Keyword>
							<KeywordVisible>False</KeywordVisible>
							<Value>F1</Value>
							<Visible>False</Visible>
						</PartProperty>
					</PartProperties>
				</Device>
				<Device>
					<ClassName>Port</ClassName>
					<PartPicture>
						<Index>0</Index>
						<MirroredHorizontally>False</MirroredHorizontally>
						<MirroredVertically>False</MirroredVertically>
						<Orientation>0</Orientation>
						<Origin>(43, 18)</Origin>
					</PartPicture>
					<PartProperties>
						<PartProperty>
							<Keyword>ports</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>1</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>td</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>0.0</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>pn</Keyword>
							<KeywordVisible>False</KeywordVisible>
							<Value>1</Value>
							<Visible>True</Visible>
						</PartProperty>
					</PartProperties>
				</Device>
				<Device>
					<ClassName>Port</ClassName>
					<PartPicture>
						<Index>0</Index>
						<MirroredHorizontally>True</MirroredHorizontally>
						<MirroredVertically>False</MirroredVertically>
						<Orientation>0</Orientation>
						<Origin>(47, 18)</Origin>
					</PartPicture>
					<PartProperties>
						<PartProperty>
							<Keyword>ports</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>1</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>td</Keyword>
							<KeywordVisible>True</KeywordVisible>
							<Value>0.0</Value>
							<Visible>False</Visible>
						</PartProperty>
						<PartProperty>
							<Keyword>pn</Keyword>
							<KeywordVisible>False</KeywordVisible>
							<Value>2</Value>
							<Visible>True</Visible>
						</PartProperty>
					</PartProperties>
				</Device>
			</Devices>
		</Schematic>
	</Drawing>
	<Equations>
		<AutoDebug>True</AutoDebug>
		<Lines>
			<EquationLine>
				<Line>f_per=2*(f_b-f_r)</Line>
			</EquationLine>
			<EquationLine>
				<Line>laplace_eq = f'(1. if f &lt;= {f_r} else (0.5*(1-np.cos(2*pi*(f-{f_b})/{f_per})) if f &lt;= {f_b} else 0.))'</Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
			<EquationLine>
				<Line></Line>
			</EquationLine>
		</Lines>
	</Equations>
	<Variables>
		<Items>
			<Variable>
				<Description>Baud Rate</Description>
				<Name>f_b</Name>
				<ReadOnly>False</ReadOnly>
				<Type>float</Type>
				<Units>Baud</Units>
				<Value>106250000000.0</Value>
				<Visible>True</Visible>
			</Variable>
			<Variable>
				<Description>receiver 3 dB bandwidth</Description>
				<Name>f_r</Name>
				<ReadOnly>False</ReadOnly>
				<Type>float</Type>
				<Units>Hz</Units>
				<Value>61625000000.0</Value>
				<Visible>True</Visible>
			</Variable>
			<Variable>
				<Description>taper period</Description>
				<Name>f_per</Name>
				<ReadOnly>True</ReadOnly>
				<Type>float</Type>
				<Units>Hz</Units>
				<Value>89250000000.0</Value>
				<Visible>False</Visible>
			</Variable>
			<Variable>
				<Description>laplace domain equation</Description>
				<Name>laplace_eq</Name>
				<ReadOnly>True</ReadOnly>
				<Type>string</Type>
				<Units>None</Units>
				<Value>(1. if f &lt;= 61625000000.0 else (0.5*(1-np.cos(2*pi*(f-106250000000.0)/89250000000.0)) if f &lt;= 106250000000.0 else 0.))</Value>
				<Visible>True</Visible>
			</Variable>
		</Items>
	</Variables>
</Project>
